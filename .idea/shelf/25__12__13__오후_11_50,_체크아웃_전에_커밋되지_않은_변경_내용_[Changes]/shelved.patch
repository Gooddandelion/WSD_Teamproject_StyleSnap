<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\"\n        \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n\n<mapper namespace=\"snap\">\n    <insert id=\"insertSnap\" parameterType=\"snap\">\n        INSERT INTO snaps (user_id, snap_title, coord_image, category, style, color, price)\n        VALUES (#{user_id}, #{snap_title}, #{image_url}, #{category}, #{style}, #{color}, #{price})\n    </insert>\n\n    <select id=\"getSnapList\" resultType=\"snap\">\n        SELECT * FROM snaps ORDER BY snap_id DESC\n    </select>\n\n    <select id=\"getSnap\" resultType=\"snap\">\n        SELECT * FROM snaps WHERE snap_id = #{snap_id}\n    </select>\n\n    <update id=\"updateSnap\">\n        UPDATE snaps SET\n                         snap_title = #{snap_title},\n                         image_url = #{image_url},\n                         category = #{category},\n                         style = #{style},\n                         color = #{color},\n                         price = #{price}\n        WHERE snap_id = #{snap_id}\n    </update>\n\n    <delete id=\"deleteSnap\">\n        DELETE FROM snaps WHERE snap_id = #{snap_id}\n    </delete>\n</mapper>
