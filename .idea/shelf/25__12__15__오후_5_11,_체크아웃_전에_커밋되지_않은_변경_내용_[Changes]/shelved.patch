<+><?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\"\n        \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n\n<mapper namespace=\"snap\">\n    <insert id=\"insertSnap\" parameterType=\"snap\">\n        INSERT INTO snaps (user_id, snap_title, coord_image, product_image, category, style, color, price)\n        VALUES (#{user_id}, #{snap_title}, #{coord_image}, #{product_image}, #{category}, #{style}, #{color}, #{price})\n    </insert>\n\n    <select id=\"getSnapList\" resultType=\"snap\">\n        SELECT * FROM snaps ORDER BY snap_id DESC\n    </select>\n\n    <select id=\"getSnap\" resultType=\"snap\">\n        SELECT * FROM snaps WHERE snap_id = #{snap_id}\n    </select>\n\n    <update id=\"updateSnap\" parameterType=\"snap\">\n        UPDATE snaps\n        <set>\n            snap_title = #{snap_title},\n            category = #{category},\n            style = #{style},\n            color = #{color},\n            price = #{price},\n            <if test=\"coord_image != null\">\n                coord_image = #{coord_image},\n            </if>\n            <if test=\"product_image != null\">\n                product_image = #{product_image},\n            </if>\n        </set>\n        WHERE snap_id = #{snap_id}\n    </update>\n\n    <update id=\"countSnap\">\n        UPDATE snaps SET\n                        view_count = view_count+1\n        WHERE snap_id = #{snap_id}\n    </update>\n\n    <delete id=\"deleteSnap\">\n        DELETE FROM snaps WHERE snap_id = #{snap_id}\n    </delete>\n\n    <update id=\"likeSnap\">\n        UPDATE snaps SET\n            like_count = like_count + 1\n        WHERE snap_id = #{snap_id}\n    </update>\n\n</mapper>
